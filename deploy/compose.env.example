# Values used by docker-compose.prod.yml itself. Copy to deploy/compose.env.
# Never commit the real file.

# Your root domain. Franchises live at <slug>.DOMAIN, the Super Admin at admin.DOMAIN.
DOMAIN=techkerala.in

# Database password. Use letters and digits only (it goes into a URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Image tag; bump it per release so you can roll back (docker compose ... up -d).
APP_VERSION=latest

# Nightly database dumps are kept this many days in ./backups
BACKUP_KEEP_DAYS=14

# Road routing (optional, `--profile routing`). Data from deploy/osrm/build.sh.
# OSRM_DATA_DIR=./osrm-data
# OSRM_MEM_LIMIT=1g          # check real use with `docker stats`; raise for kerala/southern
# OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:v5.27.1

# ── Web push (Firebase Console → Project settings → General → Your apps → Web app;
#    VAPID key: Cloud Messaging → Web Push certificates). Leave empty to run
#    without push; the in-app alerts still work. ─────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
