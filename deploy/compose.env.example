# Values used by docker-compose.prod.yml itself. Copy to deploy/compose.env.
# Never commit the real file.

# Your root domain. Franchises live at <slug>.DOMAIN, the Super Admin at admin.DOMAIN.
DOMAIN=techkerala.in

# Database password. Use letters and digits only (it goes into a URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Image tag; bump it per release so you can roll back (docker compose ... up -d).
APP_VERSION=latest

# Nightly database dumps are kept this many days in ./backups
BACKUP_KEEP_DAYS=14
