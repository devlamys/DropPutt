# DropPutt edge — TLS, static frontend, API + WebSocket proxy.
# ${DOMAIN} is filled in at container start (e.g. techkerala.in): this serves
# the apex and every franchise subdomain (kizhissery.techkerala.in, admin.…).

# Several API replicas: Docker DNS returns one address per replica and Nginx
# uses all of them. ip_hash keeps one client on one replica, which Socket.io's
# long-polling fallback needs (WebSocket works without it).
upstream api_http {
    server api:3000;
}
upstream api_socket {
    ip_hash;
    server api:3000;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

# Don't leak the Nginx version.
server_tokens off;

server {
    listen 80 default_server;
    server_name _;

    # Health probe (load balancers) and ACME HTTP-01 challenges stay on HTTP.
    location = /nginx-health { access_log off; return 200 "ok\n"; }
    location /.well-known/acme-challenge/ { root /var/www/acme; }

    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${DOMAIN} *.${DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/snippets/security-headers.conf;

    client_max_body_size 12m;   # voice notes up to 10 MB
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # ── API ──────────────────────────────────────────────────────────────
    location /api/ {
        proxy_pass http://api_http;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Liveness / readiness for external monitors.
    location = /health { proxy_pass http://api_http; access_log off; }
    location = /ready  { proxy_pass http://api_http; access_log off; }

    # ── Socket.io (WebSocket upgrade) ────────────────────────────────────
    location /socket.io/ {
        proxy_pass http://api_socket;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;   # long-lived connections
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # ── Frontend ─────────────────────────────────────────────────────────
    root /usr/share/nginx/html;

    # Hashed build files never change: cache for a year.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # Single-page app: unknown paths fall back to index.html (never cached,
    # so a new deploy is picked up immediately).
    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri /index.html;
    }
}
