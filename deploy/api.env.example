# API settings for production. Copy to deploy/api.env. Never commit the real file.
# DATABASE_URL, REDIS_URL, NODE_ENV and PORT are set by docker-compose.prod.yml.

# Number of reverse proxies in front of the API: 1 = Nginx only,
# 2 = Cloudflare proxy + Nginx. Wrong values make every client share one IP
# for rate limiting.
TRUST_PROXY=1

# Browser origins allowed by CORS / Socket.io. The app is same-origin through
# Nginx, so this can stay empty (= no cross-origin access).
CORS_ORIGINS=

# At least 32 random characters:  openssl rand -hex 48
JWT_SECRET=
REFRESH_TOKEN_EXPIRES_DAYS=30

# Plain-HTTP requests are rejected. Only set false if TLS is terminated
# upstream (e.g. Cloudflare Tunnel to an HTTP origin) and Cloudflare enforces HTTPS.
# REQUIRE_HTTPS=false

# ── Firebase push (optional until you set it up) ─────────────────────────────
# Put the service-account JSON at deploy/secrets/firebase.json
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase.json

# ── Cloudflare R2 media storage (bill photos, voice notes, gate photos) ──────
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dropputt-media
# Public URL of the bucket (custom domain such as https://media.techkerala.in)
R2_PUBLIC_BASE_URL=

# ── Native apps (leave empty until a mobile app is released) ─────────────────
MIN_APP_VERSION=
APP_STORE_URL_ANDROID=
APP_STORE_URL_IOS=
