// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  FRANCHISE_ADMIN
  VENDOR
  RIDER
  CUSTOMER
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PICKED_UP
  DELIVERED
  CANCELLED
}

enum PaymentMode {
  CASH
  WALLET
  UPI
}

enum WalletTxType {
  CREDIT
  DEBIT
}

enum WalletTxReason {
  ORDER_EARNING
  TIP
  RAIN_SURGE
  MILESTONE_BONUS
  ROYALTY_DEDUCTION
  VENDOR_PAYABLE
  MANUAL_CREDIT
  MANUAL_DEBIT
  REFUND
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
  FAILED
}

enum Platform {
  ANDROID
  IOS
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Franchise {
  id                   String               @id @default(uuid())
  name                 String
  slug                 String               @unique
  is_active            Boolean              @default(true)
  wallet_balance        Decimal              @default(0) @db.Decimal(12, 2)
  rain_surge_multiplier Decimal             @default(1.0) @db.Decimal(5, 2)
  royalty_percent      Decimal              @default(0) @db.Decimal(5, 2)
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt

  users                User[]
  vendors              Vendor[]
  riders               Rider[]
  zones                Zone[]
  orders               Order[]
  wallet_transactions  WalletTransaction[]
  push_campaigns       PushCampaign[]
  settlement_entries   SettlementEntry[]

  @@map("franchises")
}

model User {
  id                   String               @id @default(uuid())
  franchise_id         String
  phone                String
  pin_hash             String
  role                 UserRole
  name                 String?
  is_active            Boolean              @default(true)
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt

  franchise            Franchise            @relation(fields: [franchise_id], references: [id])
  rider                Rider?
  vendor               Vendor?
  refresh_tokens       RefreshToken[]
  device_registrations DeviceRegistration[]

  @@unique([phone, franchise_id])
  @@index([franchise_id])
  @@index([phone, franchise_id])
  @@map("users")
}

model Vendor {
  id           String    @id @default(uuid())
  franchise_id String
  user_id      String    @unique
  name         String
  description  String?
  image_url    String?
  is_open      Boolean   @default(false)
  is_active    Boolean   @default(true)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  franchise    Franchise @relation(fields: [franchise_id], references: [id])
  user         User      @relation(fields: [user_id], references: [id])
  products     Product[]
  orders       Order[]

  @@index([franchise_id])
  @@map("vendors")
}

model Product {
  id           String    @id @default(uuid())
  vendor_id    String
  name         String
  description  String?
  price        Decimal   @db.Decimal(12, 2)
  image_url    String?
  is_available Boolean   @default(true)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  vendor       Vendor      @relation(fields: [vendor_id], references: [id])
  order_items  OrderItem[]

  @@index([vendor_id])
  @@map("products")
}

model Rider {
  id                 String    @id @default(uuid())
  franchise_id       String
  user_id            String    @unique
  name               String
  vehicle_number     String?
  is_online          Boolean   @default(false)
  is_active          Boolean   @default(true)
  current_lat        Decimal?  @db.Decimal(10, 7)
  current_lng        Decimal?  @db.Decimal(10, 7)
  wallet_balance     Decimal   @default(0) @db.Decimal(12, 2)
  deliveries_today   Int       @default(0)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  franchise          Franchise         @relation(fields: [franchise_id], references: [id])
  user               User              @relation(fields: [user_id], references: [id])
  orders             Order[]
  wallet_transactions WalletTransaction[]
  settlement_entries SettlementEntry[]

  @@index([franchise_id])
  @@index([is_online, franchise_id])
  @@map("riders")
}

model Customer {
  id                   String               @id @default(uuid())
  franchise_id         String
  phone                String
  name                 String?
  address              String?
  lat                  Decimal?             @db.Decimal(10, 7)
  lng                  Decimal?             @db.Decimal(10, 7)
  wallet_balance        Decimal              @default(0) @db.Decimal(12, 2)
  is_active            Boolean              @default(true)
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt

  orders               Order[]
  device_registrations DeviceRegistration[]

  @@unique([phone, franchise_id])
  @@index([franchise_id])
  @@index([phone, franchise_id])
  @@map("customers")
}

model Zone {
  id              String    @id @default(uuid())
  franchise_id    String
  name            String
  base_fare       Decimal   @db.Decimal(12, 2)
  per_km_rate     Decimal   @db.Decimal(12, 2)
  platform_fee    Decimal   @default(0) @db.Decimal(12, 2)
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  franchise       Franchise @relation(fields: [franchise_id], references: [id])
  orders          Order[]

  @@index([franchise_id])
  @@map("zones")
}

model Order {
  id                     String      @id @default(uuid())
  order_number           String      @unique
  franchise_id           String
  vendor_id              String
  rider_id               String?
  customer_id            String?
  zone_id                String?
  status                 OrderStatus @default(PENDING)
  payment_mode           PaymentMode @default(CASH)

  // Delivery info
  delivery_address       String
  delivery_lat           Decimal?    @db.Decimal(10, 7)
  delivery_lng           Decimal?    @db.Decimal(10, 7)
  pickup_lat             Decimal?    @db.Decimal(10, 7)
  pickup_lng             Decimal?    @db.Decimal(10, 7)
  distance_km            Decimal?    @db.Decimal(8, 3)

  // Financials
  subtotal               Decimal     @default(0) @db.Decimal(12, 2)
  delivery_fee           Decimal     @default(0) @db.Decimal(12, 2)
  platform_fee           Decimal     @default(0) @db.Decimal(12, 2)
  tip_amount             Decimal     @default(0) @db.Decimal(12, 2)
  rain_surge_amount      Decimal     @default(0) @db.Decimal(12, 2)
  total_amount           Decimal     @default(0) @db.Decimal(12, 2)
  rider_earning          Decimal     @default(0) @db.Decimal(12, 2)
  vendor_payable         Decimal     @default(0) @db.Decimal(12, 2)
  royalty_amount         Decimal     @default(0) @db.Decimal(12, 2)

  // Flags
  rain_surge_applied     Boolean     @default(false)
  settlement_completed   Boolean     @default(false)

  // Tracking
  location_token         String?     @unique
  voice_note_url         String?
  gps_accuracy_m         Decimal?    @db.Decimal(8, 2)

  // Timestamps
  accepted_at            DateTime?
  picked_up_at           DateTime?
  delivered_at           DateTime?
  created_at             DateTime    @default(now())
  updated_at             DateTime    @updatedAt

  franchise              Franchise         @relation(fields: [franchise_id], references: [id])
  vendor                 Vendor            @relation(fields: [vendor_id], references: [id])
  rider                  Rider?            @relation(fields: [rider_id], references: [id])
  customer               Customer?         @relation(fields: [customer_id], references: [id])
  zone                   Zone?             @relation(fields: [zone_id], references: [id])
  order_items            OrderItem[]
  settlement_entries     SettlementEntry[]

  @@index([franchise_id, status])
  @@index([rider_id, status])
  @@index([customer_id])
  @@index([location_token])
  @@index([order_number])
  @@index([created_at])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid())
  order_id   String
  product_id String?
  name       String
  price      Decimal  @db.Decimal(12, 2)
  quantity   Int
  created_at DateTime @default(now())

  order      Order    @relation(fields: [order_id], references: [id])
  product    Product? @relation(fields: [product_id], references: [id])

  @@index([order_id])
  @@map("order_items")
}

model WalletTransaction {
  id           String         @id @default(uuid())
  franchise_id String?
  rider_id     String?
  type         WalletTxType
  reason       WalletTxReason
  amount       Decimal        @db.Decimal(12, 2)
  balance_after Decimal       @db.Decimal(12, 2)
  reference_id String?
  note         String?
  created_at   DateTime       @default(now())

  franchise    Franchise?     @relation(fields: [franchise_id], references: [id])
  rider        Rider?         @relation(fields: [rider_id], references: [id])

  @@index([franchise_id, created_at])
  @@index([rider_id, created_at])
  @@map("wallet_transactions")
}

model SettlementEntry {
  id            String    @id @default(uuid())
  franchise_id  String
  order_id      String
  rider_id      String?
  reference_key String    @unique
  type          String
  amount        Decimal   @db.Decimal(12, 2)
  note          String?
  created_at    DateTime  @default(now())

  franchise     Franchise @relation(fields: [franchise_id], references: [id])
  order         Order     @relation(fields: [order_id], references: [id])
  rider         Rider?    @relation(fields: [rider_id], references: [id])

  @@index([franchise_id, created_at])
  @@index([order_id])
  @@index([reference_key])
  @@map("settlement_entries")
}

model PushCampaign {
  id           String         @id @default(uuid())
  franchise_id String
  title        String
  body         String
  data         Json?
  target_roles UserRole[]
  status       CampaignStatus @default(DRAFT)
  scheduled_at DateTime?
  sent_at      DateTime?
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt

  franchise    Franchise      @relation(fields: [franchise_id], references: [id])

  @@index([franchise_id, status])
  @@index([scheduled_at, status])
  @@map("push_campaigns")
}

model RefreshToken {
  id         String    @id @default(uuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())

  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token_hash])
  @@map("refresh_tokens")
}

model DeviceRegistration {
  id           String    @id @default(uuid())
  user_id      String?
  customer_id  String?
  fcm_token    String    @unique
  platform     Platform
  app_version  String?
  is_active    Boolean   @default(true)
  last_seen_at DateTime  @default(now())
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  user         User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)
  customer     Customer? @relation(fields: [customer_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([customer_id])
  @@index([fcm_token])
  @@index([is_active, last_seen_at])
  @@map("device_registrations")
}

model IdempotencyRecord {
  id             String   @id @default(uuid())
  idempotency_key String  @unique
  status_code    Int
  response_body  Json
  created_at     DateTime @default(now())
  expires_at     DateTime

  @@index([idempotency_key])
  @@index([expires_at])
  @@map("idempotency_records")
}
