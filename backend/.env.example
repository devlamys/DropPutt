# Copy to .env and fill in real values. Never commit .env.

# ─── Database (PostgreSQL 15+) ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/dropputt?schema=public"

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
TZ="Asia/Kolkata"
# Franchise used when x-franchise-slug is missing. Development only —
# ignored when NODE_ENV=production.
DEFAULT_FRANCHISE_SLUG="kizhissery"
# Comma-separated browser origins allowed by CORS / Socket.io. Required in
# production; empty allows any origin in development.
CORS_ORIGINS=""
# Number of reverse proxies in front of the API: 0 when exposed directly,
# 1 behind Nginx, 2 behind Cloudflare + Nginx. Must be right in production,
# or rate limits see every client as the same IP.
TRUST_PROXY=0
# Run the 4 PM push scheduler in this process. Set false on all but one replica.
ENABLE_CRON=true

# ─── Auth (SPEC §49) ─────────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production-min-32-chars"
REFRESH_TOKEN_EXPIRES_DAYS=30

# ─── Firebase Admin / FCM ────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"

# ─── Cloudflare R2 / S3-compatible storage ───────────────────────────────────
R2_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="dropputt-media"
# Public base URL of the bucket (custom domain). Stored URLs are built from it.
R2_PUBLIC_BASE_URL=""
# Local upload folder, used only in development when R2 is not configured.
UPLOAD_DIR="uploads"

# ─── Redis (only needed with more than one API replica) ──────────────────────
# Enables the Socket.io Redis adapter and shared GPS replay protection.
# Leave unset for a single instance. In production, if set but unreachable,
# the API refuses to start. (Cron jobs use a database lock, not Redis.)
# REDIS_URL="redis://localhost:6379"

# ─── Mobile ──────────────────────────────────────────────────────────────────
# Native apps older than this get 403 APP_UPDATE_REQUIRED (web is never blocked).
# MIN_APP_VERSION sets both platforms; the per-platform values override it.
# Leave empty to enforce no minimum.
MIN_APP_VERSION=""
MIN_APP_VERSION_ANDROID=""
MIN_APP_VERSION_IOS=""
APP_STORE_URL_ANDROID="https://play.google.com/store/apps/details?id=in.techkerala.dropputt"
APP_STORE_URL_IOS=""

# ─── Production transport ────────────────────────────────────────────────────
# Plain-HTTP requests are rejected in production. Behind Nginx / Cloudflare set
# TRUST_PROXY to the number of proxies so the API can see the original HTTPS.
# REQUIRE_HTTPS=false disables the check (only if TLS cannot be detected).
# REQUIRE_HTTPS="true"

# ─── Tests ───────────────────────────────────────────────────────────────────
# `npm test` uses a separate database named <your db>_test (dropputt_test),
# created automatically. Set this only to use a different one; the name must
# end in "_test" because the tests empty every table.
# TEST_DATABASE_URL="postgresql://dropputt:password@localhost:5433/dropputt_test?schema=public"

# ─── Seed (prisma/seed.js) ───────────────────────────────────────────────────
# Login PIN given to every seeded user. Required when NODE_ENV=production;
# in development the seed falls back to this example value if unset.
SEED_DEFAULT_PIN="1234"
# Optional: override the seeded Super Admin phone (10 digits).
SEED_SUPER_ADMIN_PHONE="9000000001"
