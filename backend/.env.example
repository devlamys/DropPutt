# Copy to .env and fill in real values. Never commit .env.

# ─── Database (PostgreSQL 15+) ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/dropputt?schema=public"

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
TZ="Asia/Kolkata"
# Franchise used when x-franchise-slug is missing. Development only —
# ignored when NODE_ENV=production.
DEFAULT_FRANCHISE_SLUG="kizhissery"
# Comma-separated browser origins allowed by CORS / Socket.io. Required in
# production; empty allows any origin in development.
CORS_ORIGINS=""
# Number of reverse proxies in front of the API: 0 when exposed directly,
# 1 behind Nginx, 2 behind Cloudflare + Nginx. Must be right in production,
# or rate limits see every client as the same IP.
TRUST_PROXY=0
# Run the 4 PM push scheduler in this process. Set false on all but one replica.
ENABLE_CRON=true

# ─── Auth (SPEC §49) ─────────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production-min-32-chars"
REFRESH_TOKEN_EXPIRES_DAYS=30

# ─── Firebase Admin / FCM ────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"

# ─── Cloudflare R2 / S3-compatible storage ───────────────────────────────────
R2_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="dropputt-media"
# Public base URL of the bucket (custom domain). Stored URLs are built from it.
R2_PUBLIC_BASE_URL=""
# Local upload folder, used only in development when R2 is not configured.
UPLOAD_DIR="uploads"

# ─── Redis (optional: Socket.io adapter / distributed cron lock) ─────────────
REDIS_URL="redis://localhost:6379"

# ─── Mobile ──────────────────────────────────────────────────────────────────
APP_MIN_VERSION="1.0.0"

# ─── Seed (prisma/seed.js) ───────────────────────────────────────────────────
# Login PIN given to every seeded user. Required when NODE_ENV=production;
# in development the seed falls back to this example value if unset.
SEED_DEFAULT_PIN="1234"
# Optional: override the seeded Super Admin phone (10 digits).
SEED_SUPER_ADMIN_PHONE="9000000001"
