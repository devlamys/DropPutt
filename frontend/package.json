{
  "name": "dropputt-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:customer": "vite --mode customer --port 5171",
    "dev:vendor": "vite --mode vendor --port 5172",
    "dev:rider": "vite --mode rider --port 5174",
    "dev:admin": "vite --mode admin --port 5175",
    "build": "vite build",
    "build:customer": "vite build --mode customer --outDir dist-customer",
    "build:vendor": "vite build --mode vendor --outDir dist-vendor",
    "build:rider": "vite build --mode rider --outDir dist-rider",
    "build:admin": "vite build --mode admin --outDir dist-admin",
    "build:apps": "npm run build:customer && npm run build:vendor && npm run build:rider && npm run build:admin",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.3.1",
    "@capacitor/core": "^8.6.2",
    "@capacitor/push-notifications": "^8.1.3",
    "axios": "^1.21.1",
    "firebase": "10.14.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.72.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.30.6",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.21"
  }
}
