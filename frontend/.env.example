# Leave empty in development: Vite proxies /api, /uploads and /socket.io to the backend.
# In production set the full API origin, e.g. https://api.techkerala.in
VITE_API_ORIGIN=
# Backend used by the Vite dev proxy.
VITE_DEV_PROXY_TARGET=http://localhost:3000
# Franchise used on localhost / IP hosts (SPEC §4). Defaults to kizhissery.
VITE_DEFAULT_FRANCHISE_SLUG=kizhissery
# Show the one-tap demo login buttons. Always on in `npm run dev`; off in
# production builds unless set to "true".
VITE_ENABLE_DEMO_LOGIN=
# Demo accounts use the seeded PIN (SEED_DEFAULT_PIN on the backend).
VITE_DEMO_PIN=1234
